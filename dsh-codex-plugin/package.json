{
  "name": "dsh-codex-plugin",
  "version": "0.8.0",
  "description": "在 DeepSeek Harness 中并排查看和操作 Codex Desktop 会话",
  "type": "module",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.3",
    "markdown-it-emoji": "^3.1.0"
  },
  "scripts": {
    "build": "node build.js"
  }
}
